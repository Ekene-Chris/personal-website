# Copy to .env.local for local development, and set the same values in Vercel
# (Project Settings > Environment Variables).

# --- Webinar registration (/webinar) ---------------------------------------
# Server-side only. Never prefix these with NEXT_PUBLIC_.
BREVO_API_KEY=
# Numeric ID of the Brevo list that triggers the confirmation automation.
BREVO_LIST_ID=
# Saved to each contact's WEBINAR attribute, e.g. fellowship-webinar-1.
WEBINAR_ID=fellowship-webinar-1
# Google Meet joining link. Shown on the thank-you page and added to the
# calendar invites. Read at build time, so redeploy after changing it.
WEBINAR_MEET_URL=

# --- Ad tracking (optional; each pixel stays off while its value is empty) --
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# LinkedIn conversion fired on /webinar/thank-you after a registration.
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Existing site settings -------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
